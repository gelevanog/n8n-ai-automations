# Copy to .env and adjust. Every variable is optional; the defaults run the demo with the offline rules model.
# Keys stay out of the repository: put them in .env (gitignored) or your secret manager.

# ---- AI gateway: model
# fake (offline rules, default) | openrouter | qwen | openai | compat
RELAY_LLM_PROVIDER=fake
RELAY_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
RELAY_LLM_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=
# Free-only guard: any OpenRouter model id without ":free" is refused (also fallbacks, :online, plugins and a
# paid model OpenRouter served instead). Paid models need this explicit opt-in:
RELAY_ALLOW_PAID_MODELS=false
# Budget wrapper for real calls: disk cache, at most one request per N seconds, retries, a hard call budget.
RELAY_LLM_CACHE=true
RELAY_LLM_MIN_SECONDS_BETWEEN_REQUESTS=3
RELAY_LLM_MAX_CALLS=900
RELAY_LLM_MAX_RETRIES=3
RELAY_LLM_STRUCTURED_RETRIES=1

# ---- Gates (what goes to a person)
RELAY_TRIAGE_MIN_CONFIDENCE=0.75
RELAY_SPAM_MIN_CONFIDENCE=0.9
RELAY_INVOICE_MIN_CONFIDENCE=0.8
RELAY_INVOICE_AUTO_POST_LIMIT=5000
RELAY_INVOICE_AMOUNT_TOLERANCE=0.02
RELAY_FAQ_MIN_RETRIEVAL_SCORE=0.25
RELAY_FAQ_MIN_CONFIDENCE=0.75
RELAY_LEAD_HOT_SCORE=70
RELAY_LEAD_WARM_SCORE=40

# ---- Shared secrets (local demo values; change them for anything that is not on your laptop)
# Webhooks: n8n checks X-Relay-Token against the "Relay webhook secret" credential.
RELAY_WEBHOOK_TOKEN=relay-local-webhook-token
# Relay API: n8n, the dashboard and the MCP server send it as X-Relay-Token.
RELAY_API_TOKEN=relay-local-api-token
N8N_ENCRYPTION_KEY=relay-local-demo-encryption-key
POSTGRES_PASSWORD=relay
# Local n8n owner account created by `make n8n-owner` (test values for this demo only)
N8N_OWNER_EMAIL=owner@relay.localhost
N8N_OWNER_PASSWORD=Relay-local-demo-1

# ---- Ports
N8N_PORT=5678
RELAY_PORT=8100
MOCKS_PORT=8200
WEB_PORT=3000
MAILPIT_PORT=8025
SMTP_PORT=1025
