      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({ content_base64: $('Invoice received').first().json.body.content_base64, filename: $('Invoice received').first().json.body.filename || 'invoice.pdf' }) }}",
        "options": {}
      }
    },
    {
      "id": "0e127636-60c7-562b-81a0-cabf21726bf2",
      "name": "Decode PDF",
      "type": "n8n-nodes-base.convertToFile",
