      "position": [
        1000,
        0
      ],
      "parameters": {
        "operation": "toBinary",
        "sourceProperty": "content_base64",
        "binaryPropertyName": "data",
        "options": {
          "fileName": "={{ $json.filename }}",
          "mimeType": "application/pdf"
        }
      }
    },
    {
      "id": "983852c4-10ee-5177-a00a-cec8966a6bbc",
      "name": "Extract PDF text",
