        "jsonBody": "={{ JSON.stringify({ ...($('Apply approval').isExecuted ? $('Apply approval').first().json : $('Invoice decision').first().json).invoice, dedupe_key: ($('Apply approval').isExecuted ? $('Apply approval').first().json : $('Invoice decision').first().json).dedupe_key, status: ($('Apply approval').isExecuted ? $('Apply approval').first().json : $('Invoice decision').first().json).reviewed ? 'approved_by_reviewer' : 'approved', source: $('Invoice received').first().json.body.source || 'webhook', run_id: $('Start run (idempotency)').first().json.run_id }) }}",
        "options": {
          "timeout": 120000
