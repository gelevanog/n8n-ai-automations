        "jsonOutput": "={{ JSON.stringify({ ...$('Extract invoice (AI gateway)').first().json, run_id: $('Start run (idempotency)').first().json.run_id, duplicate: ($json.body || []).length > 0, issues: [...$('Extract invoice (AI gateway)').first().json.issues, ...(($json.body || []).length > 0 ? ['duplicate'] : [])], post: $('Extract invoice (AI gateway)').first().json.decision === 'auto_post' && ($json.body || []).length === 0, reviewed: false }) }}",
        "options": {}
      }
    },
