{
  "id": "RelayInvoiceIntake",
  "name": "Relay - 02 Invoice intake",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "69e33e51-f626-5c16-a8a7-00dfee24c422",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -420
      ],
      "parameters": {
        "content": "## Invoice intake\nA PDF (from inbox triage, an upload or an API call) is decoded and read with n8n's **Extract from File**; the **AI gateway** extracts the fields and checks them like a bookkeeper: line math, VAT, totals, dates, vendor and VAT ID against master data, the total printed in the document, the auto-posting limit.\n\nThe workflow then asks **accounting** whether the invoice is already booked. Clean invoices are posted; anything else waits for an approval.",
        "height": 260,
        "width": 520,
        "color": 4
      }
    },
    {
      "id": "6b5fba81-17a5-5856-a173-0e3be470f413",
      "name": "Invoice received",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "invoice-intake",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "80ecf179-565d-530e-82e8-3c1d815bfba8",
      "credentials": {
        "httpHeaderAuth": {
          "id": "relayWebhookAuth",
          "name": "Relay webhook secret"
        }
      }
    },
    {
      "id": "50ce2506-7130-5958-8a82-5764845e06ee",
      "name": "Fingerprint PDF",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        200,
        0
      ],
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "value": "={{ $('Invoice received').first().json.body.content_base64 }}",
        "dataPropertyName": "fingerprint",
        "encoding": "hex"
      }
    },
    {
      "id": "b32a10bc-7094-5d7a-a649-51ca65c788d7",
      "name": "Start run (idempotency)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RELAY_API_URL }}/ops/runs/start",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: 'invoice', idempotency_key: 'pdf:' + $json.fingerprint, execution_id: $execution.id, input: $('Invoice received').first().json.body, source: $('Invoice received').first().json.body.source || 'webhook', title: $('Invoice received').first().json.body.filename || 'invoice.pdf' }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "relayApiToken",
          "name": "Relay API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Same key twice = duplicate: answered from the first run",
      "notesInFlow": true
    },
    {
      "id": "c363d9e1-46f6-5961-a6f7-9ec59a62a756",
      "name": "Duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "83fdd84d-dde2-58e4-a624-d3c0801c1c28",
              "leftValue": "={{ $json.duplicate }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "c6b93211-8870-5b0d-aa4d-37c5b090f5b3",
      "name": "Respond: duplicate",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        800,
        -180
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'duplicate', run_id: $json.run_id, previous_status: $json.status, output: $json.output }) }}",
        "options": {}
      }
    },
    {
      "id": "987ff6ad-9d1b-5e8a-a557-2cc83e4add60",
      "name": "Attachment",
      "type": "n8n-nodes-base.set",
